{
  "name": "neoevo.io-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "npm run test:frontend && npm run test:database && npm run test:functions",
    "test:frontend": "vitest run",
    "test:database": "node --test tests/database/security.test.mjs",
    "test:functions": "node --test tests/security-functions.test.js",
    "check:functions": "deno check --frozen --config supabase/functions/create-booking/deno.json supabase/functions/create-booking/index.ts supabase/functions/send-booking-email/index.ts",
    "lint:security": "eslint src/Components/ProtectedRoute.jsx src/Components/booking/BookingForm.jsx src/lib src/pages/Login.jsx vite.config.js vitest.config.js tests supabase/functions/_shared/*.js"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@supabase/supabase-js": "^2.108.1",
    "@tailwindcss/vite": "^4.2.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.17.0",
    "tailwindcss": "^4.2.2",
    "three": "^0.185.1",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^9.39.4",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "deno": "^2.9.6",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.1.1",
    "supabase": "^2.118.0",
    "vite": "^8.0.1",
    "vitest": "^5.0.2"
  }
}
